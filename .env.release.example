# Example only: scripts do not automatically read .env files.
# Copy to .env.release, fill in values, then: set -a; source .env.release; set +a
RELEASE_VERSION=1.1.0
BUILD_NUMBER=3
BUILD_ARCHS='arm64 x86_64'

# Certificate + private key must already be imported into a Keychain.
# An identity SHA-1 from `security find-identity -v -p codesigning` also works.
CODE_SIGN_IDENTITY='Developer ID Application: YOUR NAME (YOUR_TEAM_ID)'
APPLE_TEAM_ID=YOUR_TEAM_ID
# CODE_SIGN_KEYCHAIN=/path/to/signing.keychain-db

# Choose ONE notarization authentication method.
NOTARY_KEYCHAIN_PROFILE=siniulator-notary
# APPLE_ID=you@example.com
# APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
# Or App Store Connect API key (issuer is only needed for team keys):
# NOTARY_KEY_PATH=/path/to/AuthKey.p8
# NOTARY_KEY_ID=YOUR_KEY_ID
# NOTARY_ISSUER=YOUR_ISSUER_UUID

# Sparkle keys are independent of Apple certificates and Team ID.
SPARKLE_PUBLIC_ED_KEY='PUBLIC_KEY_FROM_GENERATE_KEYS'
# Omit both to use Sparkle's default `ed25519` Keychain entry, or choose ONE:
# SPARKLE_PRIVATE_KEY_FILE=/path/outside/the/repository/sparkle-private-key
# SPARKLE_PRIVATE_KEY='CONTENTS_OF_THE_EXPORTED_PRIVATE_KEY'
